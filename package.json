{
  "name": "slippi-discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "A Discord bot for a local Super Smash Bros. Melee Slippi community leaderboard.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "commands:register": "tsx --env-file-if-exists=.env src/register-commands.ts",
    "test": "npm run build && node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:import": "node scripts/import-rank-assets.mjs",
    "emojis:sync": "node --env-file-if-exists=.env scripts/sync-application-emojis.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "discord.js": "^14.28.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.0.0",
    "prettier": "3.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true
  }
}
